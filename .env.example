# Dev bypass — set to 'true' to auto-login as founder (development only)
VITE_DEV_AUTO_LOGIN="false"

# Gemini API — required for AI lead discovery features
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Supabase — required for auth and data persistence
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Anthropic API — required for the What's On AI Agent (/whats-on-agent).
# SERVER-SIDE ONLY. Set it as a Supabase secret, never as a VITE_ variable:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Anything prefixed VITE_ is inlined into the public JS bundle at build time.
# If VITE_ANTHROPIC_API_KEY was ever set on Vercel, rotate that key.

# Stripe — required for supporter/subscription payments
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_key_here"
# Payment Link codes from Stripe Dashboard → Payment Links (the part after buy.stripe.com/)
VITE_STRIPE_PRICE_SUPPORTER="your_payment_link_code_here"
VITE_STRIPE_PRICE_FEATURED="your_payment_link_code_here"

# Discord — required for Community tab
# Get these from discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here       # server-side only — no VITE_ prefix
DISCORD_SERVER_ID=your_discord_server_id_here        # server-side reference
DISCORD_CLIENT_ID=your_discord_client_id_here        # server-side reference
VITE_DISCORD_SERVER_ID=your_discord_server_id_here   # client-side — used by Discord Widget API

# Directory Outreach Edge Function — set these as Supabase secrets:
#   supabase secrets set GMAIL_USER=you@gmail.com
#   supabase secrets set GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   supabase secrets set HUBSPOT_API_KEY=your_hubspot_private_app_token
# Gmail: enable 2FA → Google Account → Security → App Passwords → generate one
# HubSpot: Settings → Integrations → Private Apps → create app with contacts scope
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here
HUBSPOT_API_KEY=your_hubspot_private_app_token_here

# ── What's On weekly discovery ──────────────────────────────────────────
# Set these on the SERVER (Vercel project environment variables). They are
# deliberately NOT VITE_-prefixed, so they never reach the browser bundle.
#
# Until WHATS_ON_SOURCE_URL is set, the Tuesday cron exits cleanly and logs
#   "What's On discovery source not configured"
# and stages nothing. There is no fallback source and no AI generation path,
# so an unconfigured system produces no events rather than invented ones.
#
# WHATS_ON_SOURCE_URL   REQUIRED to enable discovery. A listing page that
#                       publishes schema.org Event data as JSON-LD, or an
#                       official events API endpoint returning the same.
#                       Use a source you are permitted to read; robots.txt
#                       is checked before every fetch.
# WHATS_ON_SOURCE_ID    Optional. Short slug stored as source_platform on
#                       every candidate. Defaults to the URL's hostname.
# WHATS_ON_SOURCE_LABEL Optional. Display name in the review UI.
WHATS_ON_SOURCE_URL=
WHATS_ON_SOURCE_ID=
WHATS_ON_SOURCE_LABEL=

# Protects /api/cron/discover-whats-on. Vercel Cron sends this automatically
# as "Authorization: Bearer $CRON_SECRET". If it is unset the endpoint
# refuses to run rather than being publicly triggerable.
CRON_SECRET=your_long_random_string_here

# Server-side Supabase credentials for the cron job (service role bypasses
# RLS to INSERT into pending_events). NEVER expose the service role key to
# the browser. The cron only ever inserts staging rows; it cannot publish.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
